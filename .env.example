# Copy this file to ".env" and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Any Gemini text model your key can use. Change it here, no code edits needed.
GEMINI_MODEL=gemini-3.6-flash

# Minimum seconds between Gemini calls (keeps you under free-tier limits).
GEMINI_MIN_INTERVAL=5

# Optional: force a Whisper model (tiny, base, small, medium, large-v3).
# Leave empty for automatic: "small" on CPU, "large-v3" on an NVIDIA GPU.
WHISPER_MODEL=

# Optional: full path to a specific ffmpeg binary. Leave empty for auto-detect.
FFMPEG_PATH=
