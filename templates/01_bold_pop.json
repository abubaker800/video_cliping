{
  "name": "Bold Pop",
  "description": "Big white text, black outline, current word in yellow.",
  "font": "Arial Black",
  "bold": true,
  "size": 88,
  "uppercase": true,
  "colors": { "text": "#FFFFFF", "highlight": "#FFE600", "outline": "#000000", "shadow": "#000000" },
  "outline": { "width": 8, "shadow": 3 },
  "position": { "align": "bottom", "margin_v_percent": 24, "margin_h_percent": 6 },
  "tilt": 0,
  "max_words_per_line": 3,
  "max_chars_per_line": 16,
  "animation": { "type": "highlight", "pop_scale": 112, "pop_ms": 90, "fade_ms": 0 }
}
